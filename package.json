{
  "name": "review-report",
  "version": "0.1.2",
  "private": true,
  "description": "Claude Code skill that turns a diff, branch or PR into an HTML walkthrough with plain-English line notes",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "example": "node skills/review-report/render.mjs --story skills/review-report/test/fixture.story.json --diff-file skills/review-report/test/fixture.diff --out skills/review-report/reference/example-report.html",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "update-cdn": "node scripts/update-cdn.mjs",
    "lint": "eslint --max-warnings 0 skills scripts e2e playwright.config.mjs eslint.config.js",
    "typecheck": "tsc -p tsconfig.json",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.2",
    "globals": "17.13.0",
    "typescript": "6.0.3"
  }
}
